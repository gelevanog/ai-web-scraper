# Copy to .env and adjust. Every variable is optional; the defaults run the demo with the offline model.
# Keys stay out of the repository: put them in .env (gitignored) or your secret manager.

# ---------------------------------------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------------------------------------
# fake (offline, rule-based), openrouter, qwen, openai, anthropic
SIFT_LLM_PROVIDER=fake
# Empty = the provider's default (openrouter: nvidia/nemotron-3-super-120b-a12b:free).
SIFT_LLM_MODEL=
SIFT_LLM_FALLBACK_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free
# Refuse any OpenRouter model id that does not end in ":free", paid plugins and answers served by paid models.
SIFT_REQUIRE_FREE_MODELS=true
OPENROUTER_API_KEY=
# Qwen Cloud (DashScope / Model Studio, OpenAI-compatible). DASHSCOPE_API_KEY also works.
QWEN_API_KEY=
SIFT_QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SIFT_ANTHROPIC_EFFORT=low
SIFT_LLM_REASONING_EFFORT=low
SIFT_LLM_MAX_TOKENS=16000

# Budget for real API calls: disk cache, one request per N seconds, retries, a hard cap and a JSONL ledger.
SIFT_LLM_CACHE=true
SIFT_LLM_CACHE_DIR=.cache/llm
SIFT_LLM_LEDGER=results/calls.jsonl
SIFT_LLM_MAX_CALLS=495
SIFT_LLM_MIN_SECONDS_BETWEEN_REQUESTS=3
SIFT_LLM_MAX_RETRIES=3

# ---------------------------------------------------------------------------------------------------------
# Crawling and politeness
# ---------------------------------------------------------------------------------------------------------
SIFT_USER_AGENT="SiftBot/0.1 (+https://github.com/gelevanog/ai-web-scraper; polite structured-data crawler)"
SIFT_RESPECT_ROBOTS=true
# One request per host every N seconds (robots.txt Crawl-delay wins when larger).
SIFT_MIN_SECONDS_PER_DOMAIN=1
SIFT_MAX_PAGES=60
SIFT_MAX_DEPTH=4
SIFT_FETCH_TIMEOUT_SECONDS=20
SIFT_FETCH_RETRIES=2
# auto = a headless browser only for pages that need JavaScript; always; never.
SIFT_BROWSER=auto
# A system Chrome/Chromium for Playwright (empty = Playwright's own: `uv run playwright install chromium`).
SIFT_BROWSER_EXECUTABLE=
SIFT_BROWSER_MAX_SCROLLS=12

# ---------------------------------------------------------------------------------------------------------
# Extraction
# ---------------------------------------------------------------------------------------------------------
# auto (learned rules for repeated templates, direct LLM extraction for one-off pages), learned, direct
SIFT_STRATEGY=auto
SIFT_LEARN_SAMPLE_PAGES=3
SIFT_LEARN_MAX_ATTEMPTS=3
SIFT_HEAL=true
SIFT_HEAL_MAX_PAGES=3
SIFT_INJECTION_GUARD=true
SIFT_PII_GUARD=true
SIFT_FX_FILE=configs/fx.yaml
SIFT_ANOMALY_FACTOR=20
# The date relative dates ("3 days ago") are resolved against. Empty = today. Fixed for the synthetic web.
SIFT_TODAY=2026-10-01

# ---------------------------------------------------------------------------------------------------------
# Storage, outputs, API
# ---------------------------------------------------------------------------------------------------------
SIFT_DATABASE_URL=sqlite:///.cache/sift.db
SIFT_SEED_DEMO=true
SIFT_SYNTHETIC_WEB_DIR=data/synthetic_web
# Fetch the synthetic web from a static server instead of the disk (docker compose sets this).
SIFT_SYNTHETIC_WEB_URL=
SIFT_EXPORT_DIR=data/exports
SIFT_WEBHOOK_URL=
SIFT_WEBHOOK_SECRET=
# If set, every /api request needs "Authorization: Bearer <token>" (the dashboard sends NEXT_PUBLIC_API_TOKEN).
SIFT_API_TOKEN=
SIFT_CORS_ORIGINS=http://localhost:3000
SIFT_WORKER_CONCURRENCY=2
